# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to git.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Speech-to-text model (verified from https://console.groq.com/docs/speech-to-text).
# whisper-large-v3-turbo = best speed/price. Alternative: whisper-large-v3 (most accurate).
STT_MODEL=whisper-large-v3-turbo

# Chat model (verified live against the Groq API).
# Alternatives: openai/gpt-oss-20b (faster, cheaper), qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Premium voice: Groq Orpheus TTS (same API key, ~$22 per 1M characters).
# Voices: autumn, diana, hannah (female) / austin, daniel, troy (male).
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn

# OpenAI-compatible endpoint for Groq. Do not change unless Groq announces a new URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Max uploaded audio size in MB (server-side validation; Groq allows 25MB).
MAX_AUDIO_MB=10

# Port the app runs on
PORT=8002
